{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // Both run under node's own type stripping (`npm run check`) and reach for node built-ins this
  // browser-facing config has no types for. They are verified by running, not by tsc — which is
  // also why `contraste.check.ts` reads `styles.css` off disk instead of importing it.
  "exclude": ["src/season.check.ts", "src/contraste.check.ts"]
}
